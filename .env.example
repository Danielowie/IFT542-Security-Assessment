# Copy this file to .env and fill in local values.
# NEVER commit the real .env file.

APP_ENV=development
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=student_registration
DB_USER=app_user
DB_PASS=change-me-locally

SESSION_NAME=srapp_session
SESSION_LIFETIME=1800

# Comma-separated list of hosts the URL-preview feature is allowed
# to fetch from (SSRF defence -- see src/UrlGuard.php)
URL_PREVIEW_ALLOWLIST=exampletranscripts.test,verifieddocs.test
